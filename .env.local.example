FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Resend — email notifications for contact form
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Makan Website <onboarding@resend.dev>
CONTACT_EMAIL=team@makanofficial.com

# Google Sheets — leads sheet ID + dedicated Sheets-only service account
# (least privilege). If GOOGLE_SHEETS_CLIENT_EMAIL / GOOGLE_SHEETS_PRIVATE_KEY
# are unset, the API routes fall back to reusing FIREBASE_* (full project
# authority — avoid in production; sheets-auth.ts logs a warning when it
# falls back so misconfigured deploys are visible in Vercel function logs).
GOOGLE_SHEET_ID=your-leads-sheet-id
GOOGLE_SHEETS_CLIENT_EMAIL=makan-web-sheets@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Comma-separated SHA-256 fingerprints for the production Android signing certificate.
# Required before Android verified app links can be enabled in production.
ANDROID_APP_LINK_SHA256=
